<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SubscriptIQ Security Category -->
        <record id="module_category_subscriptiq" model="ir.module.category">
            <field name="name">SubscriptIQ</field>
            <field name="description">Shared User Access and Permissions for SubscriptIQ</field>
            <field name="sequence">50</field>
        </record>

        <!-- SubscriptIQ Customer Group -->
        <record id="group_subscriptiq_customer" model="res.groups">
            <field name="name">SubscriptIQ Customer</field>
            <field name="category_id" ref="module_category_subscriptiq"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- SubscriptIQ Staff Group -->
        <record id="group_subscriptiq_staff" model="res.groups">
            <field name="name">SubscriptIQ Staff</field>
            <field name="category_id" ref="module_category_subscriptiq"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- SubscriptIQ Administrator Group -->
        <record id="group_subscriptiq_admin" model="res.groups">
            <field name="name">SubscriptIQ Administrator</field>
            <field name="category_id" ref="module_category_subscriptiq"/>
            <field name="implied_ids" eval="[(4, ref('group_subscriptiq_staff')), (4, ref('base.group_system'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
