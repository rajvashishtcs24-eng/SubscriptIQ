<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Customer Invoice Form View -->
    <record id="view_move_form_subscriptiq_billing" model="ir.ui.view">
        <field name="name">account.move.form.subscriptiq.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Subscription Billing" name="subscriptiq_billing" invisible="not x_subscription_id">
                    <group>
                        <group string="Subscription Association">
                            <field name="x_subscription_id"/>
                            <field name="x_billing_period_start"/>
                            <field name="x_billing_period_end"/>
                        </group>
                        <group string="Billing Execution">
                            <field name="x_billing_run_id"/>
                            <field name="x_billing_ledger_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
