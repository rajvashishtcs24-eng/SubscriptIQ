<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_subscriptiq_billing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.subscriptiq.billing</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="SubscriptIQ Billing" string="SubscriptIQ Billing" name="subscriptiq_billing">
                    <block title="Recurring Billing &amp; Invoicing" id="subscriptiq_billing_settings">
                        <setting string="Retry Parameters" help="Configure retry thresholds and exponential backoff parameters.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="billing_max_retries" class="col-lg-4 o_light_label"/>
                                    <field name="billing_max_retries" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="billing_retry_base_hours" class="col-lg-4 o_light_label"/>
                                    <field name="billing_retry_base_hours" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="billing_ack_max_retries" class="col-lg-4 o_light_label"/>
                                    <field name="billing_ack_max_retries" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="billing_ack_retry_base_hours" class="col-lg-4 o_light_label"/>
                                    <field name="billing_ack_retry_base_hours" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Batch &amp; Concurrency" help="Batch commit size and PostgreSQL advisory lock key.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="billing_batch_size" class="col-lg-4 o_light_label"/>
                                    <field name="billing_batch_size" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="billing_journal_id" class="col-lg-4 o_light_label"/>
                                    <field name="billing_journal_id" class="col-lg-4"/>
                                </div>
                                <div class="row mt8">
                                    <label for="billing_pg_lock_key" class="col-lg-4 o_light_label"/>
                                    <field name="billing_pg_lock_key" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_subscriptiq_billing_config_settings" model="ir.actions.act_window">
        <field name="name">Billing Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'subscriptiq_billing'}</field>
    </record>
</odoo>
