<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Menu -->
    <menuitem id="menu_subscriptiq_billing_root"
              name="SubscriptIQ Billing"
              web_icon="subscriptiq_billing,static/description/icon.png"
              groups="group_billing_user"
              sequence="45"/>

    <!-- Operations Category -->
    <menuitem id="menu_subscriptiq_billing_operations"
              name="Operations"
              parent="menu_subscriptiq_billing_root"
              sequence="10"/>

    <menuitem id="menu_subscriptiq_billing_runs"
              name="Billing Runs"
              parent="menu_subscriptiq_billing_operations"
              action="action_billing_run"
              sequence="10"/>

    <menuitem id="menu_subscriptiq_billing_ledger"
              name="Billing Ledger"
              parent="menu_subscriptiq_billing_operations"
              action="action_billing_ledger"
              sequence="20"/>

    <!-- Discounts Category -->
    <menuitem id="menu_subscriptiq_billing_discounts"
              name="Discounts"
              parent="menu_subscriptiq_billing_root"
              sequence="20"/>

    <menuitem id="menu_subscriptiq_discount_rules"
              name="Discount Rules"
              parent="menu_subscriptiq_billing_discounts"
              action="action_discount_rule"
              sequence="10"/>

    <menuitem id="menu_subscriptiq_discount_reservations"
              name="Discount Reservations"
              parent="menu_subscriptiq_billing_discounts"
              action="action_discount_reservation"
              sequence="20"/>

    <!-- Configuration Category -->
    <menuitem id="menu_subscriptiq_billing_config"
              name="Configuration"
              parent="menu_subscriptiq_billing_root"
              groups="group_billing_manager"
              sequence="90"/>

    <menuitem id="menu_subscriptiq_billing_settings"
              name="Settings"
              parent="menu_subscriptiq_billing_config"
              action="action_subscriptiq_billing_config_settings"
              sequence="10"/>
</odoo>
