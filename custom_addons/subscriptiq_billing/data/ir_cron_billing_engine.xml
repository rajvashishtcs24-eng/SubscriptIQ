<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Primary Recurring Billing Scheduled Action -->
        <record id="ir_cron_billing_engine" model="ir.cron">
            <field name="name">SubscriptIQ: Primary Daily Recurring Billing Run</field>
            <field name="model_id" ref="model_subscriptiq_billing_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_execute_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
