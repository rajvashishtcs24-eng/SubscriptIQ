<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Post-Invoice Member 1 Acknowledgement Retry Scheduled Action -->
        <record id="ir_cron_ack_retry" model="ir.cron">
            <field name="name">SubscriptIQ: Retry Failed Post-Invoice Acknowledgements</field>
            <field name="model_id" ref="model_subscriptiq_billing_ledger"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_acknowledgement()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
