<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Invoice Generation Retry Scheduled Action -->
        <record id="ir_cron_billing_retry" model="ir.cron">
            <field name="name">SubscriptIQ: Retry Failed Invoice Generations</field>
            <field name="model_id" ref="model_subscriptiq_billing_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
