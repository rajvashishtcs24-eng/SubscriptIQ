<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Billing Run -->
        <record id="seq_subscriptiq_billing_run" model="ir.sequence">
            <field name="name">Billing Run Reference</field>
            <field name="code">subscriptiq.billing.run</field>
            <field name="prefix">BRUN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
