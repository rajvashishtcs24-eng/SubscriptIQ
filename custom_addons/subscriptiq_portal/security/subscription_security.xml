<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_subscription_mgmt" model="ir.module.category">
        <field name="name">Subscription Management</field>
        <field name="description">Security access levels for Subscription Engine</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_subscription_customer" model="res.groups">
        <field name="name">Customer</field>
        <field name="category_id" ref="module_category_subscription_mgmt"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_subscription_staff" model="res.groups">
        <field name="name">Staff (Operations)</field>
        <field name="category_id" ref="module_category_subscription_mgmt"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_subscription_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_subscription_mgmt"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Customer Rules: Invoices -->
        <record id="rule_invoice_customer_isolation" model="ir.rule">
            <field name="name">Customer: Account Move Personal Isolation</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('move_type', 'in', ('out_invoice', 'out_refund')),
                ('state', '=', 'posted'),
                '|',
                ('partner_id', '=', user.partner_id.id),
                ('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Rules: Payments -->
        <record id="rule_payment_customer_isolation" model="ir.rule">
            <field name="name">Customer: Account Payment Personal Isolation</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[
                ('state', '=', 'posted'),
                '|',
                ('partner_id', '=', user.partner_id.id),
                ('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>