<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- Top-Level Root Application Menu                                   -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_root"
              name="SubscriptIQ"
              sequence="25"
              web_icon="subscriptiq_subscription,static/description/icon.png"/>

    <!-- ================================================================= -->
    <!-- Products Catalog Menu Category                                    -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_products"
              name="Products"
              parent="menu_subscriptiq_root"
              sequence="10"/>

    <!-- 1. Product Templates Action & Menu -->
    <record id="action_subscriptiq_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_is_subscription_eligible': True,
            'search_default_filter_subscription_eligible': 1,
            'default_type': 'service'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription-eligible product
            </p>
            <p>
                Configure SaaS products, recurring service plans, and subscription bundles.
            </p>
        </field>
    </record>

    <menuitem id="menu_subscriptiq_product_templates"
              name="Products"
              parent="menu_subscriptiq_products"
              action="action_subscriptiq_products"
              sequence="10"/>

    <!-- 2. Product Variants Action & Menu -->
    <record id="action_subscriptiq_product_variants" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{
            'search_default_filter_subscription_eligible': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subscription variants found
            </p>
            <p>
                Variants are generated automatically when attributes (like Brand, Tier, Region) are attached to a product.
            </p>
        </field>
    </record>

    <menuitem id="menu_subscriptiq_product_variants"
              name="Product Variants"
              parent="menu_subscriptiq_products"
              action="action_subscriptiq_product_variants"
              groups="product.group_product_variant"
              sequence="20"/>

    <!-- 3. Subscription Plans (Catalog link) -->
    <menuitem id="menu_subscriptiq_product_plans"
              name="Subscription Plans"
              parent="menu_subscriptiq_products"
              action="action_subscriptiq_plans"
              sequence="30"/>

    <!-- ================================================================= -->
    <!-- Direct Subscription Plans Menu in Top Bar                         -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_plans"
              name="Subscription Plans"
              parent="menu_subscriptiq_root"
              action="action_subscriptiq_plans"
              sequence="20"/>

    <!-- ================================================================= -->
    <!-- Quotations Menu in Top Bar                                         -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_quotations"
              name="Quotations"
              parent="menu_subscriptiq_root"
              action="action_subscriptiq_subscription_quotations"
              sequence="15"/>

    <!-- ================================================================= -->
    <!-- Subscriptions Menu in Top Bar                                      -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_subscriptions"
              name="Subscriptions"
              parent="menu_subscriptiq_root"
              action="action_subscriptiq_subscriptions"
              sequence="25"/>

    <!-- ================================================================= -->
    <!-- Configuration Menu Category                                       -->
    <!-- ================================================================= -->
    <menuitem id="menu_subscriptiq_configuration"
              name="Configuration"
              parent="menu_subscriptiq_root"
              sequence="100"/>

    <!-- 4. Product Attributes Action & Menu -->
    <record id="action_subscriptiq_product_attributes" model="ir.actions.act_window">
        <field name="name">Attributes</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a variant attribute
            </p>
            <p>
                Attributes (such as Brand, Cloud Provider, or Tier) allow dynamic variant pricing using price_extra.
            </p>
        </field>
    </record>

    <menuitem id="menu_subscriptiq_product_attributes"
              name="Attributes"
              parent="menu_subscriptiq_configuration"
              action="action_subscriptiq_product_attributes"
              groups="product.group_product_variant"
              sequence="10"/>
</odoo>
