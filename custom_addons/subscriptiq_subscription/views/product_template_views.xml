<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- 1. Product Template Form View Extension                           -->
    <!-- ================================================================= -->
    <record id="product_template_form_view_inherit_subscriptiq" model="ir.ui.view">
        <field name="name">product.template.form.inherit.subscriptiq</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_subscription_eligible"/>
                    <label for="is_subscription_eligible"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- 2. Product Template Search View Extension                         -->
    <!-- ================================================================= -->
    <record id="product_template_search_view_inherit_subscriptiq" model="ir.ui.view">
        <field name="name">product.template.search.inherit.subscriptiq</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='services']" position="after">
                <filter string="Subscription Eligible"
                        name="filter_subscription_eligible"
                        domain="[('is_subscription_eligible', '=', True)]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <field name="is_subscription_eligible"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- 3. Product Template List View Extension                           -->
    <!-- ================================================================= -->
    <record id="product_template_tree_view_inherit_subscriptiq" model="ir.ui.view">
        <field name="name">product.template.list.inherit.subscriptiq</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_subscription_eligible" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- 4. Product Variant (Product Product) List View Extension          -->
    <!-- ================================================================= -->
    <record id="product_product_tree_view_inherit_subscriptiq" model="ir.ui.view">
        <field name="name">product.product.list.inherit.subscriptiq</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="after">
                <field name="is_subscription_eligible" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
