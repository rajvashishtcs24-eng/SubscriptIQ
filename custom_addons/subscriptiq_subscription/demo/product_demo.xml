<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Demonstration Attribute: Brand -->
        <record id="demo_product_attribute_brand" model="product.attribute">
            <field name="name">Brand</field>
            <field name="create_variant">always</field>
            <field name="display_type">radio</field>
            <field name="sequence">1</field>
        </record>

        <!-- 2. Demonstration Attribute Values -->
        <record id="demo_product_attribute_value_brand_standard" model="product.attribute.value">
            <field name="name">Standard</field>
            <field name="attribute_id" ref="demo_product_attribute_brand"/>
            <field name="sequence">1</field>
        </record>

        <record id="demo_product_attribute_value_brand_odoo" model="product.attribute.value">
            <field name="name">Odoo</field>
            <field name="attribute_id" ref="demo_product_attribute_brand"/>
            <field name="sequence">2</field>
        </record>

        <record id="demo_product_attribute_value_brand_premium" model="product.attribute.value">
            <field name="name">Premium</field>
            <field name="attribute_id" ref="demo_product_attribute_brand"/>
            <field name="sequence">3</field>
        </record>

        <!-- 3. Demonstration Product: Brightloop CRM -->
        <record id="demo_product_template_brightloop_crm" model="product.template">
            <field name="name">Brightloop CRM</field>
            <field name="type">service</field>
            <field name="list_price">5000.0</field>
            <field name="standard_price">2000.0</field>
            <field name="is_subscription_eligible" eval="True"/>
            <field name="description">Brightloop CRM Cloud Subscription Service with brand editions.</field>
            <field name="attribute_line_ids" eval="[(0, 0, {
                'attribute_id': ref('demo_product_attribute_brand'),
                'value_ids': [(6, 0, [
                    ref('demo_product_attribute_value_brand_standard'),
                    ref('demo_product_attribute_value_brand_odoo'),
                    ref('demo_product_attribute_value_brand_premium'),
                ])],
            })]"/>
        </record>

        <!-- 4. Post-initialization of variant extra prices -->
        <!-- Standard: +₹0, Odoo: +₹560, Premium: +₹1,000 -->
        <function model="product.template" name="_init_demo_brightloop_crm_pricing"/>
    </data>
</odoo>
